     "output_type": "stream",
     "text": [
      "Folder structure:\n",
      "data/\n",
      "  train/\n",
      "    cats/\n",
      "      ... (2000 files)\n",
      "    dogs/\n",
      "      ... (2000 files)\n",
      "  test/\n",
      "    cats/\n",
      "      ... (500 files)\n",
      "    dogs/\n",
      "      ... (500 files)\n"
     ]
    }
   ],
   "source": [
    "import os\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from PIL import Image\n",
    "\n",
    "DATA_DIR = \"data\"\n",
    "TRAIN_DIR = os.path.join(DATA_DIR, \"train\")\n",
    "TEST_DIR = os.path.join(DATA_DIR, \"test\")\n",
    "\n",
    "# Folder structure\n",
    "print(\"Folder structure:\")\n",
    "for root, dirs, files in os.walk(DATA_DIR):\n",
    "    level = root.replace(DATA_DIR, \"\").count(os.sep)\n",
    "    indent = \"  \" * level\n",
    "    print(f\"{indent}{os.path.basename(root)}/\")\n",
    "    if files:\n",
    "        print(f\"{indent}  ... ({len(files)} files)\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2b70ff61",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Classes: ['cats', 'dogs']\n",
      "Number of classes: 2\n",
      "Image counts per folder: {'train/cats': 2000, 'train/dogs': 2000, 'test/cats': 500, 'test/dogs': 500}\n",
      "Total number of images: 5000\n"
     ]
    }
   ],
   "source": [
    "classes = sorted(os.listdir(TRAIN_DIR))\n",
    "counts = {}\n",
    "for split in [\"train\", \"test\"]:\n",
    "    for c in classes:\n",
    "        p = os.path.join(DATA_DIR, split, c)\n",
    "        counts[f\"{split}/{c}\"] = len(os.listdir(p))\n",
    "total_images = sum(counts.values())\n",
    "\n",
    "print(\"Classes:\", classes)\n",
    "print(\"Number of classes:\", len(classes))\n",
    "print(\"Image counts per folder:\", counts)\n",
    "print(\"Total number of images:\", total_images)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ccef1a63",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "('cats', 'cat.10676.jpg', (500, 374), 'RGB')\n",
      "('dogs', 'dog.11205.jpg', (415, 480), 'RGB')\n"
     ]
    }
   ],
   "source": [
    "# Check original image dimensions (before resizing)\n",
    "sample_dims = []\n",
    "for c in classes:\n",
    "    folder = os.path.join(TRAIN_DIR, c)\n",
    "    fname = os.listdir(folder)[0]\n",
    "    with Image.open(os.path.join(folder, fname)) as im:\n",
    "        sample_dims.append((c, fname, im.size, im.mode))\n",
    "\n",
    "for row in sample_dims:\n",
    "    print(row)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0a0c546a",
   "metadata": {},
   "source": [
    "The raw images come in different original dimensions (e.g. 500×374, 415×480). They will all be resized to a fixed 128×128 during preprocessing so the CNN receives a consistent input shape."
   ]
  },
  {
   "cell_type": "code",
